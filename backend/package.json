{
  "name": "aquafind-backend",
  "version": "1.1.0",
  "description": "AquaFind - water refill station locator (Express + Supabase PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env test/smoke.js",
    "migrate:sqlite": "node --no-warnings --env-file-if-exists=.env scripts/migrate-sqlite-to-supabase.js"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
