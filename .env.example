# Local use: copy this file to backend/.env and fill it in (the server reads it automatically; never commit it).
# Hosting (Render, Railway, Fly...): copy the same names into the host's environment settings instead.

# Supabase: Project Settings > Database > Connection string > "Session pooler" (works on IPv4 hosts such as Render).
# Replace [YOUR-PASSWORD] with the database password; encode special characters (@ becomes %40, # becomes %23).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

NODE_ENV=production
# Required in production: 24+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Creates the admin of station s1 on the very first run (production never seeds demo accounts).
ADMIN_EMAIL=
# 10+ characters
ADMIN_PASSWORD=
# System administrator account (created, or an existing account with this email is promoted).
SUPERADMIN_EMAIL=
# 10+ characters, used only when the account is created
SUPERADMIN_PASSWORD=
# Set to true when behind Render / Railway / Fly / nginx, so HTTPS detection and rate limiting work.
TRUST_PROXY=true
# Only for split hosting or the Android app, e.g. https://localhost,https://app.example.com
ALLOWED_ORIGINS=
# Optional: AquaBot uses Claude with live station data; without it the built-in helper answers.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Google / Facebook sign-in (real OAuth through Supabase Auth). Leave both empty to switch the buttons off.
# Supabase dashboard > Project Settings > API: "Project URL" and the PUBLIC "anon" (or "publishable") key.
# NEVER put the service_role / secret key here: the server refuses to start the social feature if it sees one.
# The Google / Facebook client secrets live only in the Supabase dashboard, never in this file or in the code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: database connections kept open (default 10). Leave at the default on Supabase's free plan.
# DB_POOL_MAX=10
# Only for a local Postgres without TLS:
# DATABASE_SSL=0
